APP_NAME=StoreBuddy Sync Server (TypeScript)
API_PREFIX=/api/v1
PORT=5000
JWT_SECRET=your-jwt-secret-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/storebuddy_sync?retryWrites=true&w=majority

CORS_ALLOW_ORIGINS=*
DEFAULT_TRIAL_DAYS=7
PLATFORM_TENANT_ID=platform
PLATFORM_ADMIN_NAME=Platform Admin
PLATFORM_ADMIN_EMAIL=admin@storebuddy.com
PLATFORM_ADMIN_PASSWORD=admin123
